{
  "name": "chess-with-friends",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "db:migrate:local": "wrangler d1 migrations apply chess-with-friends --local --persist-to=.wrangler/state",
    "worker:dev": "npm run build && npm run db:migrate:local && wrangler dev --local --persist-to=.wrangler/state --port 8787",
    "prebuild": "npm run positions:verify",
    "build": "vite build",
    "postbuild": "node scripts/verify-precache.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "playwright test",
    "test:push": "node scripts/verify-push-policy.mjs && node scripts/verify-push-copy-contract.mjs",
    "positions:verify": "node scripts/verify-positions.mjs",
    "vapid:generate": "node scripts/generate-vapid.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^5.0.0",
    "chess.js": "^1.4.0",
    "three": "^0.185.1",
    "vite": "^7.0.0",
    "wrangler": "4.128.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
