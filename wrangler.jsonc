{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chess-with-friends",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // `true` means every request enters the worker first — required so the
    // worker can override Cache-Control headers on HTML / manifest / sw.js
    // (Workers Assets otherwise serves everything with max-age=0,
    // must-revalidate, which iOS Safari heuristically caches longer than
    // the browser should, stranding phones on stale deploys).
    "run_worker_first": true
  },
  "vars": {
    "APP_NAME": "Chess with Friends",
    "VAPID_PUBLIC_KEY": "BDtx_9EucoyV7Dvn4nXvliLMzGuf2wIHm9PMmuyZIm66sDXRRqhQGCjPGEZNezfrE--mi5YJnJi3XdbiLghZFfE"
  },
  "durable_objects": {
    "bindings": [
      { "name": "APP_DO", "class_name": "AppDO" },
      { "name": "GAME_DO", "class_name": "GameDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AppDO", "GameDO"]
    }
  ]
}
